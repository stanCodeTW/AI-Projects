TW\",\"2303.TW\",\"2412.TW\",\n","              \"2884.TW\",\"2886.TW\",\"3711.TW\",\"2357.TW\",\"1216.TW\",\n","              \"2885.TW\",\"2345.TW\",\"3231.TW\",\"3034.TW\",\"2892.TW\",\n","              \"2379.TW\",\"6669.TW\",\"2890.TW\",\"5880.TW\",\"2880.TW\",\n","              \"2383.TW\",\"3661.TW\",\"3017.TW\",\"2883.TW\",\"3008.TW\",\n","              ]\n","\n","for stock_id in stock_list:\n","  df = yf.download(stock_id, start=\"2019-10-01\", interval=\"1d\")\n","\n","  if isinstance(df.columns, pd.MultiIndex):\n","        # 如果是多層次欄位，只保留第一層（去除ticker部分）\n","        df.columns = df.columns.droplevel(1)\n","\n","  # 清理欄位名稱，移除空格\n","  df.columns = [col.strip() for col in df.columns]\n","\n","  print(f\"欄位名稱: {list(df.columns)}\")\n","\n","  close = df['Close'].squeeze().to_numpy().astype(float)\n","  high = df['High'].squeeze().to_numpy().astype(float)\n","  low = df['Low'].squeeze().to_numpy().astype(float)\n","  volume = df['Volume'].squeeze().to_numpy().astype(float)\n","\n","  # 計算指標\n","  # ===== 1. 趨勢指標 =====\n","  df['MA10'] = talib.SMA(df['Close'].squeeze(), timeperiod=10)\n","  df['MA20'] = talib.SMA(df['Close'].squeeze(), timeperiod=20)\n","  df['MA30'] = talib.SMA(df['Close'].squeeze(), timeperiod=30)\n","\n","  # ===== 2. 動量指標 =====\n","  df['RSI14'] = talib.RSI(df['Close'].squeeze(), timeperiod=14)\n","\n","  # ===== 3. 成交量指標 =====\n","  df['OBV'] = talib.OBV(close, volume)\n","\n","\n","  # 處理 NaN（保留時間序列完整性）\n","  df = df[df.index >= \"2019-12-31\"]\n","  df = df.ffill()  # 先用前值填充\n","\n","  # 只保留需要的欄位\n","  columns_to_keep = ['MA10', 'MA20', 'MA30', 'RSI14', 'OBV']\n","  df = df[columns_to_keep]\n","\n","  # 剩餘缺失值補0\n","  df = df.fillna(0)\n","\n","  # 儲存完整檔\n","  df.to_csv(os.path.join(folder_path, f\"{stock_id}.csv\"))\n","\n","print(df.head())\n","print(\"全部股票處理完成 ✅\")\n"],"metadata":{"id":"VgQC5eHqfDd7","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1755251630717,"user_tz":-480,"elapsed":63698,"use